<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atten.Data</RootNamespace>
    <Description>Repository, migrations, connection, and backup. No windows, colors, or controls.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atten.Data.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atten.Core\Atten.Core.csproj" />
  </ItemGroup>

</Project>
