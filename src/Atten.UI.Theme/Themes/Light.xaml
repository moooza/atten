<ResourceDictionary
    x:Class="Atten.UI.Theme.Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="InkColor">#1F2933</Color>
    <Color x:Key="MutedColor">#64748B</Color>
    <Color x:Key="LineColor">#D8DEE6</Color>
    <Color x:Key="AccentColor">#69089B</Color>
    <Color x:Key="HighlightColor">#DEC9E9</Color>
    <Color x:Key="HighlightStrongColor">#D2B5E1</Color>
    <Color x:Key="DangerColor">#B42318</Color>
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Highlight" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="HighlightStrong" Color="{StaticResource HighlightStrongColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />

    <SolidColorBrush x:Key="ListViewItemBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource HighlightStrongColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource HighlightStrongColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminate" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="RadioButtonBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonBackgroundPointerOver" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonBackgroundPressed" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonBackgroundDisabled" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonForeground" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPressed" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePressed" Color="{StaticResource AccentColor}" />
</ResourceDictionary>
