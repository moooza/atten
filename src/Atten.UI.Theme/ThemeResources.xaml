<ResourceDictionary
    x:Class="Atten.UI.Theme.ThemeResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="AppFontFamily">Tahoma</FontFamily>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="TitleFontSize">18</x:Double>
    <Thickness x:Key="ControlPadding">14,8</Thickness>
    <Thickness x:Key="CompactPadding">8,6</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <x:Double x:Key="FieldGap">8</x:Double>
    <x:Double x:Key="PageGap">12</x:Double>
    <x:Double x:Key="CompactFieldWidth">72</x:Double>
    <x:Double x:Key="FormMaxWidth">420</x:Double>
    <x:Double x:Key="ShellToolbarHeight">72</x:Double>
    <Thickness x:Key="NavButtonPadding">14,6</Thickness>
    <Thickness x:Key="PagePadding">20</Thickness>
    <Thickness x:Key="FormPadding">18,16</Thickness>
    <Thickness x:Key="ListCellPadding">8,6</Thickness>
    <Thickness x:Key="HeaderBottomMargin">0,0,0,10</Thickness>
    <Thickness x:Key="FieldHintMargin">0,4,0,8</Thickness>
    <Thickness x:Key="FormActionsMargin">0,12,0,0</Thickness>
    <Thickness x:Key="FormHostMargin">0,8</Thickness>
    <Thickness x:Key="SummaryCardPadding">12,8</Thickness>
    <x:Double x:Key="FormWideMaxWidth">480</x:Double>

    <Style x:Key="AppButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Accent}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccent}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="AppButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="AppButtonCompactPrimary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Accent}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccent}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="AppButtonCompactSecondary" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="AppButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Danger}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccent}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Danger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="AppCheckBox" TargetType="CheckBox">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
    </Style>

    <Style x:Key="AppPopupPresenter" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="IsDefaultShadowEnabled" Value="False" />
    </Style>

    <Style x:Key="AppNavButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource NavButtonPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppCaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,8,0,2" />
    </Style>

    <Style x:Key="AppInkText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppDangerText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Danger}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppSuccessText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Success}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppListHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="AppListCellText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="AppPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="AppListViewItem" TargetType="ListViewItem">
        <Setter Property="Background" Value="{ThemeResource Surface}" />
        <Setter Property="Foreground" Value="{ThemeResource Ink}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource ListCellPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="AppNavButtonSelected" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Accent}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccent}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource NavButtonPadding}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
