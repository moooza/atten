<Page
    x:Class="Atten.App.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource Surface}"
    FlowDirection="RightToLeft">
    <Grid Padding="{StaticResource PagePadding}">
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            FlowDirection="RightToLeft"
            Spacing="{StaticResource PageGap}">
            <Border Style="{StaticResource AppWidget}">
                <StackPanel
                    Spacing="{StaticResource FieldGap}"
                    FlowDirection="LeftToRight"
                    HorizontalAlignment="Stretch">
                    <TextBlock
                        x:Name="HolidayTitle"
                        Style="{StaticResource AppTitleText}"
                        FlowDirection="RightToLeft"
                        HorizontalAlignment="Stretch"
                        TextAlignment="Start" />
                    <TextBlock
                        x:Name="HolidayStatus"
                        Style="{StaticResource AppDangerText}"
                        FlowDirection="RightToLeft"
                        HorizontalAlignment="Stretch"
                        TextAlignment="Start" />
                    <TextBlock
                        x:Name="HolidayHint"
                        Style="{StaticResource AppCaptionText}"
                        FlowDirection="RightToLeft"
                        HorizontalAlignment="Stretch"
                        TextAlignment="Start"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
