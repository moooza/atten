<UserControl
    x:Class="Atten.App.Leaves.LeaveForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Atten.App.Shared"
    xmlns:theme="using:Atten.UI.Theme"
    FlowDirection="RightToLeft">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnEnterAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </UserControl.KeyboardAccelerators>
    <Border
        Style="{StaticResource AppPanel}"
        Padding="{StaticResource FormPadding}"
        MaxWidth="{StaticResource FormWideMaxWidth}"
        HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource AppTitleText}" />
            <TextBlock
                x:Name="Hint"
                Style="{StaticResource AppCaptionText}"
                TextWrapping="Wrap"
                Margin="{StaticResource FieldHintMargin}" />

            <TextBlock Text="پرسنل" Style="{StaticResource AppFieldLabel}" />
            <shared:PersonnelPicker x:Name="PersonPicker" HorizontalAlignment="Stretch" />

            <TextBlock Text="تاریخ شروع" Style="{StaticResource AppFieldLabel}" />
            <theme:ShamsiDateField x:Name="StartField" HorizontalAlignment="Stretch" />

            <TextBlock Text="تاریخ پایان" Style="{StaticResource AppFieldLabel}" />
            <theme:ShamsiDateField x:Name="EndField" HorizontalAlignment="Stretch" />

            <TextBlock Text="میزان مرخصی" Style="{StaticResource AppFieldLabel}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource FieldGap}">
                <theme:AppTextBox
                    x:Name="DaysBox"
                    Width="{StaticResource CompactFieldWidth}"
                    TextAlignment="Center"
                    BeforeTextChanging="OnWholeNumberChanging" />
                <TextBlock
                    Text="روز"
                    Style="{StaticResource AppListCellText}"
                    VerticalAlignment="Center" />
                <theme:AppTextBox
                    x:Name="HoursBox"
                    Width="{StaticResource CompactFieldWidth}"
                    TextAlignment="Center"
                    BeforeTextChanging="OnWholeNumberChanging" />
                <TextBlock
                    Text="ساعت"
                    Style="{StaticResource AppListCellText}"
                    VerticalAlignment="Center" />
                <theme:AppTextBox
                    x:Name="MinutesBox"
                    Width="{StaticResource CompactFieldWidth}"
                    TextAlignment="Center"
                    BeforeTextChanging="OnMinutesChanging" />
                <TextBlock
                    Text="دقیقه"
                    Style="{StaticResource AppListCellText}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                x:Name="Preview"
                Style="{StaticResource AppInkText}"
                Margin="0,8,0,0" />
            <TextBlock
                x:Name="ErrorText"
                Style="{StaticResource AppDangerText}"
                Margin="0,4,0,0" />

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{StaticResource FieldGap}"
                Margin="{StaticResource FormActionsMargin}">
                <theme:AppButton
                    x:Name="SaveButton"
                    Kind="Primary"
                    Click="OnSave" />
                <theme:AppButton
                    Content="انصراف"
                    Kind="Secondary"
                    Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
