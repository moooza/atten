<UserControl
    x:Class="Atten.App.Leaves.LeaveForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Atten.App.Shared"
    xmlns:theme="using:Atten.UI.Theme"
    FlowDirection="LeftToRight">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnEnterAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </UserControl.KeyboardAccelerators>
    <Border
        Style="{StaticResource AppPanel}"
        Padding="{StaticResource FormPadding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <StackPanel>
            <TextBlock
                x:Name="Heading"
                Style="{StaticResource AppTitleText}"
                HorizontalAlignment="Right"
                TextAlignment="Right" />
            <TextBlock
                x:Name="Hint"
                Style="{StaticResource AppCaptionText}"
                HorizontalAlignment="Right"
                TextAlignment="Right"
                TextWrapping="Wrap"
                Margin="{StaticResource FieldHintMargin}" />

            <TextBlock
                Text="پرسنل"
                Style="{StaticResource AppFieldLabel}"
                HorizontalAlignment="Right"
                TextAlignment="Right" />
            <shared:PersonnelPicker x:Name="PersonPicker" HorizontalAlignment="Stretch" />
            <TextBlock
                x:Name="RemainingText"
                Style="{StaticResource AppAccentText}"
                Margin="{StaticResource FieldHintMargin}" />

            <TextBlock
                Text="تاریخ شروع"
                Style="{StaticResource AppFieldLabel}"
                HorizontalAlignment="Right"
                TextAlignment="Right" />
            <theme:ShamsiDateField x:Name="StartField" HorizontalAlignment="Stretch" />

            <TextBlock
                Text="تاریخ پایان"
                Style="{StaticResource AppFieldLabel}"
                HorizontalAlignment="Right"
                TextAlignment="Right" />
            <theme:ShamsiDateField x:Name="EndField" HorizontalAlignment="Stretch" />

            <TextBlock
                Text="میزان مرخصی"
                Style="{StaticResource AppFieldLabel}"
                HorizontalAlignment="Right"
                TextAlignment="Right" />
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                FlowDirection="RightToLeft"
                Spacing="{StaticResource FieldGap}">
                <theme:AppTextBox
                    x:Name="DaysBox"
                    Width="{StaticResource AmountFieldWidth}"
                    TextAlignment="Center"
                    BeforeTextChanging="OnWholeNumberChanging" />
                <TextBlock
                    Text="روز"
                    Style="{StaticResource AppListCellText}"
                    VerticalAlignment="Center" />
                <theme:AppTextBox
                    x:Name="HoursBox"
                    Width="{StaticResource AmountFieldWidth}"
                    TextAlignment="Center"
                    BeforeTextChanging="OnWholeNumberChanging" />
                <TextBlock
                    Text="ساعت"
                    Style="{StaticResource AppListCellText}"
                    VerticalAlignment="Center" />
                <theme:AppTextBox
                    x:Name="MinutesBox"
                    Width="{StaticResource AmountFieldWidth}"
                    TextAlignment="Center"
                    BeforeTextChanging="OnMinutesChanging" />
                <TextBlock
                    Text="دقیقه"
                    Style="{StaticResource AppListCellText}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                x:Name="Preview"
                Style="{StaticResource AppCaptionText}"
                HorizontalAlignment="Right"
                TextAlignment="Right"
                TextWrapping="Wrap"
                Margin="{StaticResource FieldHintMargin}" />

            <TextBlock
                Text="توضیحات (اختیاری)"
                Style="{StaticResource AppFieldLabel}"
                HorizontalAlignment="Right"
                TextAlignment="Right" />
            <theme:AppTextBox
                x:Name="DescriptionBox"
                HorizontalAlignment="Stretch"
                FlowDirection="RightToLeft"
                TextAlignment="Left" />
            <TextBlock
                x:Name="ErrorText"
                Style="{StaticResource AppDangerText}"
                HorizontalAlignment="Right"
                TextAlignment="Right"
                Margin="0,4,0,0" />

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                FlowDirection="RightToLeft"
                Spacing="{StaticResource FieldGap}"
                Margin="{StaticResource FormActionsMargin}">
                <theme:AppButton
                    x:Name="SaveButton"
                    Kind="Primary"
                    Click="OnSave" />
                <theme:AppButton
                    Content="انصراف"
                    Kind="Secondary"
                    Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
