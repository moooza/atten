<Page
    x:Class="Atten.App.Leaves.LeavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atten.App.Leaves"
    xmlns:shared="using:Atten.App.Shared"
    xmlns:theme="using:Atten.UI.Theme"
    Background="{ThemeResource Surface}"
    FlowDirection="RightToLeft">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid x:Name="ListRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="{StaticResource HeaderBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource PageGap}">
                    <TextBlock Text="مرخصی‌ها" Style="{StaticResource AppTitleText}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource AppCaptionText}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource FieldGap}">
                    <TextBlock x:Name="Notice" Style="{StaticResource AppDangerText}" />
                    <theme:AppButton
                        Content="ویرایش"
                        Kind="Secondary"
                        Click="OnEdit" />
                    <theme:AppButton
                        Content="ثبت مرخصی"
                        Kind="Primary"
                        Click="OnAdd" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Left"
                Spacing="{StaticResource PageGap}"
                Margin="{StaticResource HeaderBottomMargin}">
                <TextBlock
                    Text="پرسنل"
                    Style="{StaticResource AppFieldLabel}"
                    Margin="0"
                    VerticalAlignment="Center" />
                <shared:PersonnelPicker x:Name="PersonPicker" />
                <theme:AppYearDropdown x:Name="YearDropdown" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="2"
                MaxHeight="{StaticResource YearCardsMaxHeight}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Margin="{StaticResource HeaderBottomMargin}">
                <ItemsControl x:Name="YearCards">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource AppPanel}"
                                Padding="{StaticResource SummaryCardPadding}"
                                Margin="{StaticResource HeaderBottomMargin}"
                                HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding Title}"
                                        Style="{StaticResource AppListAccentText}" />
                                    <TextBlock
                                        Text="{Binding Notice}"
                                        Style="{StaticResource AppListCellText}"
                                        Visibility="{Binding NoticeVisibility}"
                                        Margin="{StaticResource FieldHintMargin}" />
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource Line}"
                                        Margin="{StaticResource FormActionsMargin}" />
                                    <Grid
                                        ColumnSpacing="{StaticResource FieldGap}"
                                        Margin="{StaticResource FieldHintMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Text="ذخیره"
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Text="{Binding Carry}"
                                        Style="{StaticResource AppListCellText}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="+"
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="استحقاق"
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Text="{Binding Earned}"
                                        Style="{StaticResource AppListCellText}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Text="−"
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="ثبت‌شده"
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="4"
                                        Text="{Binding Used}"
                                        Style="{StaticResource AppListCellText}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="5"
                                        Text="="
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Text="مانده"
                                        Style="{StaticResource AppCaptionText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="6"
                                        Text="{Binding Remaining}"
                                        Style="{StaticResource AppTitleText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding RemainingOkVisibility}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="6"
                                        Text="{Binding Remaining}"
                                        Style="{StaticResource AppTitleDangerText}"
                                        FlowDirection="LeftToRight"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right"
                                        Visibility="{Binding RemainingDangerVisibility}" />
                                </Grid>
                                <StackPanel Visibility="{Binding ActionsVisibility}">
                                    <Border
                                        Height="1"
                                        Background="{ThemeResource Line}"
                                        Margin="{StaticResource FormActionsMargin}" />
                                    <Grid
                                        ColumnSpacing="{StaticResource PageGap}"
                                        Margin="{StaticResource FieldHintMargin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{Binding TransferLine}"
                                            Style="{StaticResource AppListCellText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding LeftoverLine}"
                                            Style="{StaticResource AppListCellText}" />
                                        <theme:AppButton
                                            Grid.Column="2"
                                            Content="انتقال / تسویه"
                                            Kind="Secondary"
                                            Click="OnLeftover" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="3"
                Text="یک پرسنل را انتخاب کنید."
                Style="{StaticResource AppCaptionText}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <Border x:Name="TablePanel" Grid.Row="3" Style="{StaticResource AppPanel}" Visibility="Collapsed">
                <theme:AppListView
                    x:Name="LeavesList"
                    Background="{ThemeResource Surface}"
                    BorderThickness="0"
                    SelectionMode="Single"
                    DoubleTapped="OnRowDoubleTapped"
                    RightTapped="OnRowRightTapped"
                    SelectionChanged="OnSelectionChanged">
                    <ListView.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="{StaticResource ListCellPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="شناسه" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="1" Text="نوع" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="2" Text="تاریخ شروع" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="3" Text="تاریخ پایان" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="4" Text="میزان" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="5" Text="تاریخ افزودن" Style="{StaticResource AppListHeaderText}" />
                            </Grid>
                            <Border
                                Grid.Row="1"
                                Height="1"
                                Background="{ThemeResource Line}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItem}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LeaveRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind IdText}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind StartDate}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind EndDate}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Amount}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind CreatedAt}" Style="{StaticResource AppListCellText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </theme:AppListView>
            </Border>
        </Grid>
    </Grid>
</Page>
