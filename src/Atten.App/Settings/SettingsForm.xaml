<UserControl
    x:Class="Atten.App.Settings.SettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:Atten.UI.Theme">
    <Grid
        MinWidth="260"
        Padding="{StaticResource FormPadding}"
        FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Text="تنظیمات"
            Style="{StaticResource AppTitleText}"
            HorizontalAlignment="Right"
            TextAlignment="Right" />
        <TextBlock
            Grid.Row="1"
            Text="قالب"
            Style="{StaticResource AppFieldLabel}"
            HorizontalAlignment="Right"
            TextAlignment="Right" />
        <theme:AppThemeSwitch
            x:Name="ThemeSwitch"
            Grid.Row="2"
            HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>
