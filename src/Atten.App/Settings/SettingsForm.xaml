<UserControl
    x:Class="Atten.App.Settings.SettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="using:Atten.UI.Theme">
    <Grid
        MinWidth="260"
        Padding="{StaticResource FormPadding}"
        FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <theme:AppThemeSwitch
            x:Name="ThemeSwitch"
            Grid.Row="0"
            HorizontalAlignment="Stretch" />
        <theme:AppButton
            x:Name="AdvancedButton"
            Grid.Row="1"
            Margin="{StaticResource FormActionsMargin}"
            Kind="Secondary"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Click="OnAdvanced" />
    </Grid>
</UserControl>
