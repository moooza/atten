<Page
    x:Class="Atten.App.Personnel.PersonnelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atten.App.Personnel"
    xmlns:theme="using:Atten.UI.Theme"
    Background="{ThemeResource Surface}"
    FlowDirection="RightToLeft">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid x:Name="ListRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="{StaticResource HeaderBottomMargin}">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource PageGap}">
                    <TextBlock Text="لیست پرسنل" Style="{StaticResource AppTitleText}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource AppCaptionText}" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Spacing="{StaticResource FieldGap}">
                    <TextBlock x:Name="Notice" Style="{StaticResource AppDangerText}" />
                    <theme:AppButton
                        Content="ویرایش"
                        Kind="Secondary"
                        Click="OnEdit" />
                    <theme:AppButton
                        Content="افزودن پرسنل"
                        Kind="Primary"
                        Click="OnAdd" />
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                Text="هنوز پرسنلی ثبت نشده است."
                Style="{StaticResource AppCaptionText}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <Border x:Name="TablePanel" Grid.Row="1" Style="{StaticResource AppPanel}">
                <ListView
                    x:Name="PeopleList"
                    Background="{ThemeResource Surface}"
                    BorderThickness="0"
                    SelectionMode="Single"
                    DoubleTapped="OnRowDoubleTapped"
                    SelectionChanged="OnSelectionChanged">
                    <ListView.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="{StaticResource ListCellPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="شناسه" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="1" Text="کد پرسنلی" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="2" Text="نام" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="3" Text="نام خانوادگی" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="4" Text="ساعت کاری" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="5" Text="شماره همراه" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="6" Text="تاریخ افزودن" Style="{StaticResource AppListHeaderText}" />
                                <TextBlock Grid.Column="7" Text="تاریخ به‌روزرسانی" Style="{StaticResource AppListHeaderText}" />
                            </Grid>
                            <Border
                                Grid.Row="1"
                                Height="1"
                                Background="{ThemeResource Line}" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItem}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PersonnelRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind IdText}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind RemoteId}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind FirstName}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind LastName}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DailyHours}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Mobile}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind CreatedAt}" Style="{StaticResource AppListCellText}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind UpdatedAt}" Style="{StaticResource AppListCellText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <ScrollViewer
            x:Name="FormHost"
            Visibility="Collapsed"
            VerticalScrollBarVisibility="Auto">
            <local:PersonnelForm
                x:Name="Editor"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="{StaticResource FormHostMargin}" />
        </ScrollViewer>
    </Grid>
</Page>
