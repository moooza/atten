<Page
    x:Class="Atten.App.Calculation.CalculationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:Atten.App.Shared"
    xmlns:theme="using:Atten.UI.Theme"
    Background="{ThemeResource Surface}"
    FlowDirection="RightToLeft">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnEnterAccelerator" />
    </Page.KeyboardAccelerators>
    <Grid Padding="{StaticResource PagePadding}">
        <Grid x:Name="SheetRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="{StaticResource HeaderBottomMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource PageGap}">
                    <TextBlock Text="محاسبه" Style="{StaticResource AppTitleText}" />
                </StackPanel>
                <TextBlock
                    x:Name="Notice"
                    Grid.Column="1"
                    Style="{StaticResource AppDangerText}"
                    VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                Margin="{StaticResource HeaderBottomMargin}"
                HorizontalAlignment="Left"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Spacing="{StaticResource PageGap}">
                    <TextBlock
                        Text="کارمند"
                        Style="{StaticResource AppFieldLabel}"
                        Margin="0"
                        VerticalAlignment="Center" />
                    <shared:PersonnelPicker x:Name="PersonPicker" />
                    <TextBlock
                        Text="از تاریخ"
                        Style="{StaticResource AppFieldLabel}"
                        Margin="0"
                        VerticalAlignment="Center" />
                    <theme:ShamsiDateField x:Name="StartField" />
                    <TextBlock
                        Text="تا تاریخ"
                        Style="{StaticResource AppFieldLabel}"
                        Margin="0"
                        VerticalAlignment="Center" />
                    <theme:ShamsiDateField x:Name="EndField" />
                    <theme:AppButton
                        Content="نمایش"
                        Kind="Primary"
                        Click="OnShow" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock
                x:Name="RangeTotals"
                Grid.Row="2"
                Style="{StaticResource AppInkText}"
                HorizontalAlignment="Stretch"
                TextAlignment="Start"
                TextWrapping="Wrap"
                Margin="{StaticResource HeaderBottomMargin}"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="3"
                Text="کارمند و بازه تاریخ را انتخاب کنید."
                Style="{StaticResource AppCaptionText}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <Border
                x:Name="TablePanel"
                Grid.Row="3"
                Style="{StaticResource AppPanel}"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        x:Name="HeaderScroll"
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled">
                        <Border
                            x:Name="HeaderHost"
                            Background="{ThemeResource Surface}"
                            BorderBrush="{ThemeResource Line}"
                            BorderThickness="0,0,0,1" />
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="BodyScroll"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ViewChanged="OnSheetScroll">
                        <StackPanel x:Name="SheetHost" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
